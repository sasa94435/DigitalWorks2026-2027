---
import { getStudentProjects } from '../lib/github';

// スライダーに表示する画像リスト（枚数の増減やファイル名の変更はここを編集）
const headerImages = [
  { src: '/header1.png', alt: 'Student Work Gallery 2026 - Slide 1' },
  { src: '/header2.png', alt: 'Student Work Gallery 2026 - Slide 2' },
  { src: '/header3.png', alt: 'Student Work Gallery 2026 - Slide 3' },
];

// 取得したプロジェクト一覧をビルド時にランダムにシャッフル
const allProjects = (await getStudentProjects()).sort(() => Math.random() - 0.5);

// Topics に 'featured-2026' が含まれる作品を優秀作品として抽出や
const featuredProjects = allProjects.filter((project) =>
  project.topics?.includes('featured-2026')
);

// それ以外の作品
const regularProjects = allProjects.filter(
  (project) => !project.topics?.includes('featured-2026')
);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Student Work Gallery 2026</title>
  </head>
  <body class="bg-yellow-300 text-gray-900 p-4 sm:p-6 md:p-12 min-h-screen">
    <!-- ヘッダースライダー -->
    <header class="max-w-7xl mx-auto mb-10 sm:mb-16">
      <div
        id="header-slider"
        class="relative w-full overflow-hidden rounded-2xl sm:rounded-3xl shadow-xl border-2 border-gray-900/10 bg-gray-900 group select-none"
      >
        <!-- スライド画像トラック -->
        <div
          id="slider-track"
          class="flex transition-transform duration-500 ease-out"
        >
          {headerImages.map((img) => (
            <div class="w-full shrink-0">
              <img
                src={img.src}
                alt={img.alt}
                class="w-full h-auto max-h-96 object-cover block"
              />
            </div>
          ))}
        </div>

        <!-- 画像が2枚以上ある場合のみ矢印ボタンとドットを表示 -->
        {headerImages.length > 1 && (
          <>
            <!-- 前へボタン -->
            <button
              id="prev-btn"
              type="button"
              aria-label="前のスライド"
              class="absolute left-3 sm:left-4 top-1/2 -translate-y-1/2 z-10 w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-black/45 hover:bg-black/75 text-white flex items-center justify-center transition opacity-80 sm:opacity-0 sm:group-hover:opacity-100 backdrop-blur-xs cursor-pointer"
            >
              ‹
            </button>

            <!-- 次へボタン -->
            <button
              id="next-btn"
              type="button"
              aria-label="次のスライド"
              class="absolute right-3 sm:right-4 top-1/2 -translate-y-1/2 z-10 w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-black/45 hover:bg-black/75 text-white flex items-center justify-center transition opacity-80 sm:opacity-0 sm:group-hover:opacity-100 backdrop-blur-xs cursor-pointer"
            >
              ›
            </button>

            <!-- 下部インジケーター（ドット） -->
            <div
              id="slider-dots"
              class="absolute bottom-3 sm:bottom-4 left-1/2 -translate-x-1/2 z-10 flex space-x-2"
            >
              {headerImages.map((_, index) => (
                <button
                  type="button"
                  aria-label={`スライド ${index + 1}`}
                  class={`w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full transition-all cursor-pointer ${
                    index === 0 ? 'bg-white scale-110' : 'bg-white/50 hover:bg-white/80'
                  }`}
                />
              ))}
            </div>
          </>
        )}
      </div>
    </header>

    <main class="max-w-7xl mx-auto space-y-12 sm:space-y-16">

      <!-- ================= 優秀作品 (Featured Section) ================= -->
      {featuredProjects.length > 0 && (
        <section class="space-y-4 sm:space-y-6">
          <div class="flex flex-wrap items-center gap-2 sm:gap-3 border-b border-amber-500/30 pb-3">
            <span class="text-xl sm:text-2xl">🏆</span>
            <h2 class="text-xl sm:text-2xl font-bold text-gray-700 tracking-wide">
              FEATURED WORKS
            </h2>
            <span class="bg-rose-500/20 text-rose-600 text-xs font-semibold px-2.5 py-1 rounded-full border border-rose-500/60">
              ピックアップ作品
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
            {featuredProjects.map((project) => {
              const screenshotUrl = `https://api.microlink.io/?url=${encodeURIComponent(project.homepage)}&screenshot=true&embed=screenshot.url`;

              return (
                <article class="relative bg-gradient-to-b from-gray-900 to-gray-950 border-2 border-amber-500/40 rounded-2xl overflow-hidden shadow-2xl shadow-amber-500/10 hover:border-amber-400 transition-all duration-300 group flex flex-col">
                  <!-- 優秀作品バッジ -->
                  <div class="absolute top-3 right-3 sm:top-4 sm:right-4 z-10 bg-gradient-to-r from-amber-500 to-orange-500 text-black text-[10px] sm:text-xs font-black px-2.5 py-1 rounded-full shadow-md uppercase tracking-wider">
                    ★ Featured
                  </div>

                  <div class="aspect-video w-full bg-gray-800 overflow-hidden relative">
                    <img 
                      src={screenshotUrl} 
                      alt={project.name} 
                      class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                      loading="lazy"
                    />
                  </div>
                  
                  <div class="p-5 sm:p-7 flex-1 flex flex-col justify-between space-y-4 sm:space-y-6">
                    <div>
                      <!-- メタ情報：ユーザー名 / リポジトリ名 -->
                      <div class="flex items-center space-x-2 mb-3 min-w-0 text-xs text-gray-400 font-mono">
                        <img src={project.owner.avatar_url} class="w-5 h-5 rounded-full border border-gray-700 shrink-0" />
                        <span class="truncate">@{project.owner.login} / <span class="text-gray-500">{project.name}</span></span>
                      </div>

                      <!-- Description -->
                      <p class="text-white text-base sm:text-lg font-medium leading-relaxed line-clamp-4 group-hover:text-amber-200 transition">
                        {project.description || '説明なし'}
                      </p>
                    </div>

                    <div class="flex items-center justify-between pt-4 border-t border-gray-800/80 gap-2">
                      <a 
                        href={project.homepage} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="px-4 sm:px-5 py-2 sm:py-2.5 bg-amber-500 hover:bg-amber-400 text-black text-xs font-bold rounded-xl transition shadow-lg shadow-amber-500/20 shrink-0"
                      >
                        サイトを見る ↗
                      </a>
                      <a 
                        href={project.html_url} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="text-xs text-gray-400 hover:text-white transition font-mono truncate"
                      >
                        GitHub ↗
                      </a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      )}

      <!-- ================= 通常作品 (Regular Section) ================= -->
      <section class="space-y-4 sm:space-y-6">
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 border-b border-gray-800 pb-3">
          <span class="text-lg sm:text-xl">🗂</span>
          <h2 class="text-lg sm:text-xl font-bold text-gray-700 tracking-wide">
            ALL PROJECTS
          </h2>
          <span class="text-xs text-gray-500 font-mono">
            ({regularProjects.length})
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6">
          {regularProjects.map((project) => {
            const screenshotUrl = `https://api.microlink.io/?url=${encodeURIComponent(project.homepage)}&screenshot=true&embed=screenshot.url`;

            return (
              <article class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden shadow-lg hover:border-indigo-500/60 transition duration-300 flex flex-col group">
                <div class="aspect-video w-full bg-gray-800 overflow-hidden">
                  <img 
                    src={screenshotUrl} 
                    alt={project.name} 
                    class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                    loading="lazy"
                  />
                </div>
                
                <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between space-y-4">
                  <div>
                    <!-- メタ情報：ユーザー名 / リポジトリ名 -->
                    <div class="flex items-center space-x-2 mb-2.5 min-w-0 text-xs text-gray-400 font-mono">
                      <img src={project.owner.avatar_url} class="w-4 h-4 rounded-full shrink-0" />
                      <span class="truncate">@{project.owner.login} / <span class="text-gray-500">{project.name}</span></span>
                    </div>

                    <!-- Description -->
                    <p class="text-gray-100 text-sm sm:text-base font-normal leading-normal line-clamp-3 group-hover:text-indigo-300 transition">
                      {project.description || '説明なし'}
                    </p>
                  </div>

                  <div class="flex items-center justify-between pt-3 border-t border-gray-800 gap-2">
                    <a 
                      href={project.homepage} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="px-3 py-1.5 bg-gray-200 hover:bg-gray-400 text-black text-xs font-semibold rounded-lg transition shrink-0"
                    >
                      サイトを見る ↗
                    </a>
                    <a 
                      href={project.html_url} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="text-xs text-gray-500 hover:text-gray-300 transition truncate"
                    >
                      GitHub ↗
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>

    </main>

    <!-- スライダー制御スクリプト -->
    <script>
      const slider = document.getElementById('header-slider');
      const track = document.getElementById('slider-track');
      const prevBtn = document.getElementById('prev-btn');
      const nextBtn = document.getElementById('next-btn');
      const dotsContainer = document.getElementById('slider-dots');

      if (slider && track && dotsContainer) {
        const dots = Array.from(dotsContainer.querySelectorAll('button'));
        const totalSlides = dots.length;
        let currentIndex = 0;
        let autoPlayTimer = null;

        if (totalSlides > 1) {
          const updateSlider = (index) => {
            currentIndex = (index + totalSlides) % totalSlides;
            track.style.transform = `translateX(-${currentIndex * 100}%)`;

            dots.forEach((dot, i) => {
              if (i === currentIndex) {
                dot.classList.remove('bg-white/50', 'hover:bg-white/80');
                dot.classList.add('bg-white', 'scale-110');
              } else {
                dot.classList.remove('bg-white', 'scale-110');
                dot.classList.add('bg-white/50', 'hover:bg-white/80');
              }
            });
          };

          const startAutoPlay = () => {
            stopAutoPlay();
            autoPlayTimer = window.setInterval(() => {
              updateSlider(currentIndex + 1);
            }, 5000); // 5秒ごとに自動スライド
          };

          const stopAutoPlay = () => {
            if (autoPlayTimer) {
              clearInterval(autoPlayTimer);
              autoPlayTimer = null;
            }
          };

          prevBtn?.addEventListener('click', () => {
            updateSlider(currentIndex - 1);
            startAutoPlay();
          });

          nextBtn?.addEventListener('click', () => {
            updateSlider(currentIndex + 1);
            startAutoPlay();
          });

          dots.forEach((dot, i) => {
            dot.addEventListener('click', () => {
              updateSlider(i);
              startAutoPlay();
            });
          });

          // PCでカーソルが乗っている間は自動再生を一時停止
          slider.addEventListener('mouseenter', stopAutoPlay);
          slider.addEventListener('mouseleave', startAutoPlay);

          // スマホでの左右スワイプ操作に対応
          let touchStartX = 0;
          slider.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
            stopAutoPlay();
          }, { passive: true });

          slider.addEventListener('touchend', (e) => {
            const touchEndX = e.changedTouches[0].screenX;
            const diff = touchStartX - touchEndX;
            if (Math.abs(diff) > 40) {
              updateSlider(diff > 0 ? currentIndex + 1 : currentIndex - 1);
            }
            startAutoPlay();
          }, { passive: true });

          startAutoPlay();
        }
      }
    </script>
  </body>
</html>